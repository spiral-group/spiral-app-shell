{
  "name": "spiral-app-shell",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "Trusted shell + runtime for Spiral Interactive Posts (Brief 0066, ADR-0007)",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.artifact.config.ts && pnpm pack:artifacts",
    "build:runtime": "vite build",
    "build:artifacts": "vite build --config vite.artifact.config.ts",
    "build:ios": "pnpm build && rm -rf ios/Sources/dist ios/Sources/SpiralAppTestArtifacts/artifacts && cp -R dist ios/Sources/dist && mv ios/Sources/dist/artifacts ios/Sources/SpiralAppTestArtifacts/artifacts",
    "dev": "vite",
    "lint:types": "tsc --noEmit",
    "test": "node scripts/check-capabilities.mjs && vitest run",
    "check:capabilities": "node scripts/check-capabilities.mjs",
    "verify:layout": "vitest run --config vitest.browser.config.ts",
    "verify:layout:baseline": "node scripts/layout-baseline.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "pack:artifacts": "node --experimental-strip-types scripts/pack-artifacts.mjs",
    "catalog:pack": "node --experimental-strip-types scripts/catalog-pack.mjs"
  },
  "dependencies": {
    "es-module-lexer": "^3.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sucrase": "^3.35.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser": "^3.2.7",
    "happy-dom": "^20.14.5",
    "pi-claude-code-provider": "0.4.0",
    "playwright": "^1.63.0",
    "typebox": "^1.3.34",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
